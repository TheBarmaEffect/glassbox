{
  "name": "glassbox-notion-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Explicit-comment Notion adapter for the public GlassBox Lite MCP.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test 'test/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
