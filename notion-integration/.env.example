PORT=8787
PUBLIC_BASE_URL=https://notion-glassbox.example.com
GLASSBOX_MCP_URL=https://glassbox-platform-gateway.onrender.com/mcp

# Single-workspace/internal connection mode. Keep this only in the host's secret store.
NOTION_ACCESS_TOKEN=
NOTION_WORKSPACE_ID=

# Public OAuth mode. All values come from Notion's Creator dashboard.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_AUTHORIZATION_URL=
NOTION_OAUTH_REDIRECT_URI=https://notion-glassbox.example.com/oauth/callback

# Public OAuth needs durable encrypted storage. Generate 32 bytes with:
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
NOTION_TOKEN_STORE_FILE=/var/lib/glassbox-notion/notion.token-store

# Set after Notion sends its one-time subscription verification payload.
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Required only during webhook setup. Use a separate high-entropy value.
SETUP_ADMIN_SECRET=
