# Required: Anthropic API key for the verification engines.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model used for the internal verification calls.
# Defaults to claude-sonnet-4-6 (cost-efficient, strong reasoning).
GLASSBOX_MODEL=claude-sonnet-4-6

# Optional: max tokens for any single verification call. Defaults to 2048.
GLASSBOX_MAX_TOKENS=2048

# Optional: how strictly the ECS formula penalises a single weak dimension.
# "arithmetic" (default) uses weighted mean; "geometric" zeroes ECS if any
# dimension is zero.
GLASSBOX_ECS_MODE=arithmetic
