# Core
PORT=8080
ANTHROPIC_API_KEY=
GLASSBOX_MODEL=claude-sonnet-4-6
PLATFORM_SHARED_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://glassbox-platforms.example.com
PLATFORM_MAX_CONCURRENCY=1
PLATFORM_MAX_QUEUE=50
PLATFORM_RATE_LIMIT=10
PLATFORM_DAILY_REQUEST_LIMIT=100
PLATFORM_ESTIMATED_JOB_MS=60000
PLATFORM_JOB_TIMEOUT_MS=600000
# Pilot-safe default: only exact tenant keys below may use the gateway.
PLATFORM_ALLOW_PUBLIC=false
PILOT_TENANT_ALLOWLIST=api,discord:YOUR_GUILD_ID,slack:YOUR_TEAM_ID,telegram:YOUR_CHAT_ID,github:OWNER/REPO,reddit:YOUR_TEST_SUBREDDIT
TRUST_PROXY_HOPS=1

# Discord (outgoing interactions; no Gateway connection required)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Slack (single-workspace pilot)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-url-safe-secret

# Reddit classic OAuth pilot (requires Reddit approval and explicit subreddit opt-in)
# Keep false unless Reddit has approved this exact app and external AI-processing use case in writing.
REDDIT_DATA_API_APPROVED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=script:glassbox-platform-gateway:0.1.0 (by /u/YOUR_USERNAME)
REDDIT_SUBREDDIT_ALLOWLIST=your_test_subreddit
REDDIT_POLL_INTERVAL_MS=30000

# GitHub App
GITHUB_WEBHOOK_SECRET=
# Production GitHub App auth:
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Single-repository pilot fallback:
GITHUB_TOKEN=

# Optional MCP process override
# GLASSBOX_SERVER_COMMAND=node
# GLASSBOX_SERVER_ARGS_JSON=["/absolute/path/to/glassbox-mcp.js"]
