{
  "name": "glassbox-platform-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform-native Discord, Slack, Telegram, GitHub, and Reddit adapters for GlassBox.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke:mcp": "npm run build --silent && node dist/scripts/smoke-mcp.js",
    "smoke:verify": "npm run build --silent && node dist/scripts/smoke-verify.js",
    "register:discord": "tsx scripts/register-discord.ts",
    "set-webhook:telegram": "tsx scripts/set-telegram-webhook.ts"
  },
  "dependencies": {
    "@glassbox-framework/mcp": "1.0.3",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
