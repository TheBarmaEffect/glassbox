{
  "private": true,
  "name": "glassbox-audit",
  "version": "0.1.0",
  "description": "User-invoked GlassBox Lite reasoning audits for Reddit posts and comments.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "dev": "devvit playtest",
    "lint": "eslint 'src/**/*.ts'",
    "login": "devvit login",
    "publish": "npm run check && devvit publish --public",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test 'src/**/*.test.ts'",
    "test:types": "tsc --build",
    "check": "npm run test:types && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@devvit/start": "0.13.10",
    "@devvit/web": "0.13.10",
    "@hono/node-server": "^2.1.0",
    "@types/node": "^22.19.19",
    "devvit": "0.13.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "hono": "^4.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  }
}
